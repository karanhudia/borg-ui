{
  "name": "borg-web-ui-frontend",
  "version": "2.4.8",
  "type": "module",
  "description": "React frontend for Borg UI",
  "license": "AGPL-3.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.106.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.21.0",
    "clsx": "^2.0.0",
    "cron-parser": "^5.10.3",
    "date-fns": "^4.4.0",
    "i18next": "^26.7.2",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.13",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.0",
    "axios-mock-adapter": "^2.1.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "snapshots": "npm run visual:screenshots",
    "visual:screenshots": "npm run build-storybook && node scripts/generate-storybook-snapshots.mjs",
    "visual:report": "node scripts/visual-regression-report.mjs",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check:locales": "node ../scripts/check-locale-parity.js",
    "release": "cd .. && ./scripts/release.sh",
    "start:dev": "cd .. && ./scripts/dev.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
